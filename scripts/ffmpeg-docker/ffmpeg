#!/bin/sh
#
# Runs ffmpeg from a Docker image instead of a local install.
#
# Put this directory first on PATH so generate_preview.swift picks it up:
#
#   PATH="$PWD/scripts/ffmpeg-docker:$PATH" swift generate_preview.swift
#
# The current directory and $TMPDIR are mounted at the same paths inside the
# container, so files under either work unchanged. Docker Desktop shares
# /var/folders (where $TMPDIR lives) by default; Colima only shares $HOME
# unless $TMPDIR is added to `mounts:` in colima.yaml. Without that, pass
# --temp-dir build/preview-tmp so frames are written under the repo instead.

set -eu

readonly IMAGE="mwader/static-ffmpeg:9.0.2"

if ! command -v docker >/dev/null 2>&1; then
    echo "error: docker not found. Install Docker (or Colima) or a local ffmpeg." >&2
    exit 1
fi

# Build the docker args in front of the ffmpeg args: [mounts...] IMAGE ffmpeg-args
set -- "$IMAGE" "$@"
set -- -v "$PWD:$PWD" "$@"
if [ -n "${TMPDIR:-}" ] && [ -d "$TMPDIR" ]; then
    tmp="${TMPDIR%/}"
    case "$PWD/" in "$tmp"/*) ;; *) set -- -v "$tmp:$tmp" "$@" ;; esac
fi

exec docker run --rm -w "$PWD" "$@"
